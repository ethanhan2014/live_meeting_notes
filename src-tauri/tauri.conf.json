{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Live Meeting Notes",
  "version": "0.4.0",
  "identifier": "local.live-meeting-notes",
  "build": {"beforeDevCommand": "npm run prepare:resources && npm run dev:web", "devUrl": "http://127.0.0.1:1420", "beforeBuildCommand": "npm run build:web && npm run prepare:resources", "frontendDist": "../dist"},
  "app": {
    "windows": [{"label": "main", "create": false, "title": "Live Meeting Notes", "width": 1280, "height": 900, "minWidth": 900, "minHeight": 700}],
    "security": {"csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"}
  },
  "bundle": {
    "active": true, "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": {"../resources/runtime/": "runtime/"},
    "macOS": {"minimumSystemVersion": "12.0", "infoPlist": "Info.plist"}
  }
}
