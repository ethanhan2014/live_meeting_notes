{
  "name": "live-meeting-notes",
  "version": "0.4.0",
  "private": true,
  "description": "Tauri desktop meeting transcription with local WhisperX and AI notes",
  "scripts": {
    "start": "tauri dev",
    "dev:web": "vite",
    "build:web": "vite build",
    "test": "node --test",
    "test:python": "python3 -m unittest discover -s test -p 'test_*.py'",
    "prepare:resources": "node scripts/prepare-resources.cjs",
    "build": "tauri build",
    "build:win": "tauri build",
    "dist:win": "tauri build",
    "dist:mac": "tauri build --bundles app,dmg",
    "release:mac": "node scripts/release-macos.cjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.0",
    "vite": "^7.3.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.0"
  }
}
